# ==========================================
# CONFIGURAÇÕES DO GOOGLE CLOUD (GCP) E BIGQUERY
# ==========================================
# Insira o ID do seu projeto no Google Cloud
GCP_PROJECT_ID=seu-id-de-projeto-aqui

LAKE_BIGQUERY=true
BQ_LOCATION=US
BQ_DATASET_PREFIXO=alfabetizacao

# ==========================================
# CONFIGURAÇÕES DO PUBSUB (Streaming)
# ==========================================
PUBSUB_TOPIC_ID=alfabetizacao-eventos
PUBSUB_SUBSCRIPTION_ID=alfabetizacao-eventos-sub

BIGQUERY_DATASET_ID=alfabetizacao_streaming
BIGQUERY_TABLE_VALIDOS_ID=eventos_validos_particionado
BIGQUERY_TABLE_INVALIDOS_ID=eventos_invalidos
BIGQUERY_TABLE_METRICAS_ID=metricas_streaming
BIGQUERY_MAX_BYTES_BILLED=1073741824

STREAMING_ANO=2024
STREAMING_BATCH_SIZE=10
STREAMING_BATCH_MAX_WAIT_SECONDS=10
STREAMING_INTERVAL_SECONDS=5
STREAMING_MAX_TEST_EVENTS=30
MODO_TESTE=false
STREAMING_TEST_DETERMINISTIC=false

# ==========================================
# CONFIGURAÇÕES DE ALERTAS (Gmail / SMTP)
# ==========================================
# Necessário para testar o envio de alertas por e-mail em caso de falhas de qualidade.
# (Se for apenas rodar o notebook principal de batch, pode deixar com e-mails fictícios)
GMAIL_REMETENTE=seu-email@gmail.com
GMAIL_DESTINATARIO=email-destino@gmail.com
GMAIL_SENHA_APP=sua-senha-de-aplicativo-do-gmail